{
  "name": "ngxsmk-socket-io-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace for the ngxsmk-socket-io Angular library",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo --port 4200",
    "start:docs": "ng serve demo --port 4200",
    "build": "ng build ngxsmk-socket-io",
    "size": "node scripts/check-bundle-size.mjs",
    "build:demo": "ng build demo",
    "build:docs": "ng build demo",
    "build:docs:gh": "node scripts/write-demo-socket-env.mjs && ng build demo --configuration=github-pages",
    "watch": "ng build ngxsmk-socket-io --watch --configuration development",
    "test": "ng test ngxsmk-socket-io --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test ngxsmk-socket-io",
    "lint": "ng lint ngxsmk-socket-io && ng lint demo",
    "typecheck": "tsc -p projects/ngxsmk-socket-io/tsconfig.lib.json --noEmit && tsc -p projects/demo/tsconfig.app.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example:server": "npm --prefix examples/chat-server install && npm --prefix examples/chat-server start",
    "validate:consumer": "npm run build && npm --prefix examples/consumer install && npm --prefix examples/consumer run typecheck",
    "validate:angular-matrix": "npm run build && node scripts/validate-angular-matrix.mjs",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build && npm run size && npm run format:check"
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "4.8.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular-eslint/builder": "^19.8.1",
    "@angular-eslint/eslint-plugin": "^19.8.1",
    "@angular-eslint/eslint-plugin-template": "^19.8.1",
    "@angular-eslint/schematics": "^19.8.1",
    "@angular-eslint/template-parser": "^19.8.1",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@eslint/js": "^9.39.5",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.13.10",
    "angular-eslint": "^19.8.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.0",
    "prettier": "^3.5.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1"
  }
}
